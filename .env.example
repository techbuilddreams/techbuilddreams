# Web3Forms access key for the contact form
# Get yours at https://web3forms.com
REACT_APP_WEB3FORMS_KEY=your_access_key_here

# GA4 measurement ID. Leave unset to disable analytics entirely
# (the tag never renders). Find it in GA4 > Admin > Data streams.
NEXT_PUBLIC_GA_ID=

# Shared secret for the daily IndexNow cron at /api/indexnow.
# Vercel sends this as `Authorization: Bearer <value>`.
CRON_SECRET=
